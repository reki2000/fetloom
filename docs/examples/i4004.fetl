// FetLoom Intel 4004 compatible architectural sample
// Gate/register/control logic is written in FetLoom. Rom/Ram/Cap/Clk are built-ins.
// Bit 0 is always the least significant bit of a bus.

module inv(a -> y) { Pmos(a, Vcc, y) Nmos(a, y, Gnd) }
module buf(a -> y) { inv(a, _n) inv(_n, y) }
module nand2(a, b -> y) { Pmos(a, Vcc, y) Pmos(b, Vcc, y) Nmos(a, y, _n) Nmos(b, _n, Gnd) }
module and2(a, b -> y) { nand2(a, b, _n) inv(_n, y) }
module or2(a, b -> y) { inv(a, _na) inv(b, _nb) nand2(_na, _nb, y) }
module xor2(a, b -> y) { nand2(a,b,_n0) nand2(a,_n0,_n1) nand2(b,_n0,_n2) nand2(_n1,_n2,y) }
module mux2(s, a, b -> y) { inv(s,_ns) and2(_ns,a,_a) and2(s,b,_b) or2(_a,_b,y) }
module and3(a,b,c -> y) { and2(a,b,_x) and2(_x,c,y) }
module and4(a,b,c,d -> y) { and2(a,b,_x) and2(c,d,_z) and2(_x,_z,y) }
module or3(a,b,c -> y) { or2(a,b,_x) or2(_x,c,y) }
module or4(a,b,c,d -> y) { or2(a,b,_x) or2(c,d,_z) or2(_x,_z,y) }
module fulladder(a,b,cin -> sum,cout) { xor2(a,b,_x) xor2(_x,cin,sum) and2(a,b,_c0) and2(_x,cin,_c1) or2(_c0,_c1,cout) }

module pack2(a0, a1 -> y[2]) {
  buf(a0, y[0])
  buf(a1, y[1])
}
module pack3(a0, a1, a2 -> y[3]) {
  buf(a0, y[0])
  buf(a1, y[1])
  buf(a2, y[2])
}
module pack4(a0, a1, a2, a3 -> y[4]) {
  buf(a0, y[0])
  buf(a1, y[1])
  buf(a2, y[2])
  buf(a3, y[3])
}
module pack6(a0, a1, a2, a3, a4, a5 -> y[6]) {
  buf(a0, y[0])
  buf(a1, y[1])
  buf(a2, y[2])
  buf(a3, y[3])
  buf(a4, y[4])
  buf(a5, y[5])
}
module pack8(a0, a1, a2, a3, a4, a5, a6, a7 -> y[8]) {
  buf(a0, y[0])
  buf(a1, y[1])
  buf(a2, y[2])
  buf(a3, y[3])
  buf(a4, y[4])
  buf(a5, y[5])
  buf(a6, y[6])
  buf(a7, y[7])
}
module pack12(a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11 -> y[12]) {
  buf(a0, y[0])
  buf(a1, y[1])
  buf(a2, y[2])
  buf(a3, y[3])
  buf(a4, y[4])
  buf(a5, y[5])
  buf(a6, y[6])
  buf(a7, y[7])
  buf(a8, y[8])
  buf(a9, y[9])
  buf(a10, y[10])
  buf(a11, y[11])
}
module buf3(a[3] -> y[3]) {
  buf(a[0], y[0])
  buf(a[1], y[1])
  buf(a[2], y[2])
}
module buf4(a[4] -> y[4]) {
  buf(a[0], y[0])
  buf(a[1], y[1])
  buf(a[2], y[2])
  buf(a[3], y[3])
}
module buf8(a[8] -> y[8]) {
  buf(a[0], y[0])
  buf(a[1], y[1])
  buf(a[2], y[2])
  buf(a[3], y[3])
  buf(a[4], y[4])
  buf(a[5], y[5])
  buf(a[6], y[6])
  buf(a[7], y[7])
}
module buf12(a[12] -> y[12]) {
  buf(a[0], y[0])
  buf(a[1], y[1])
  buf(a[2], y[2])
  buf(a[3], y[3])
  buf(a[4], y[4])
  buf(a[5], y[5])
  buf(a[6], y[6])
  buf(a[7], y[7])
  buf(a[8], y[8])
  buf(a[9], y[9])
  buf(a[10], y[10])
  buf(a[11], y[11])
}
module mux3(s, a[3], b[3] -> y[3]) {
  mux2(s, a[0], b[0], y[0])
  mux2(s, a[1], b[1], y[1])
  mux2(s, a[2], b[2], y[2])
}
module mux4(s, a[4], b[4] -> y[4]) {
  mux2(s, a[0], b[0], y[0])
  mux2(s, a[1], b[1], y[1])
  mux2(s, a[2], b[2], y[2])
  mux2(s, a[3], b[3], y[3])
}
module mux8(s, a[8], b[8] -> y[8]) {
  mux2(s, a[0], b[0], y[0])
  mux2(s, a[1], b[1], y[1])
  mux2(s, a[2], b[2], y[2])
  mux2(s, a[3], b[3], y[3])
  mux2(s, a[4], b[4], y[4])
  mux2(s, a[5], b[5], y[5])
  mux2(s, a[6], b[6], y[6])
  mux2(s, a[7], b[7], y[7])
}
module mux12(s, a[12], b[12] -> y[12]) {
  mux2(s, a[0], b[0], y[0])
  mux2(s, a[1], b[1], y[1])
  mux2(s, a[2], b[2], y[2])
  mux2(s, a[3], b[3], y[3])
  mux2(s, a[4], b[4], y[4])
  mux2(s, a[5], b[5], y[5])
  mux2(s, a[6], b[6], y[6])
  mux2(s, a[7], b[7], y[7])
  mux2(s, a[8], b[8], y[8])
  mux2(s, a[9], b[9], y[9])
  mux2(s, a[10], b[10], y[10])
  mux2(s, a[11], b[11], y[11])
}
module dlatch(d,en -> q) { Nmos(en,d,_s) Cap(_s) inv(_s,_n) inv(_n,q) }
module dff(d,clk -> q) { inv(clk,_nclk) dlatch(d,_nclk,_m) dlatch(_m,clk,q) }
module dffr(d,clk,reset -> q) { mux2(reset,d,Gnd,_d) dff(_d,clk,q) }
module reg1e(d,en,clk,reset -> q) { mux2(en,q,d,_n) dffr(_n,clk,reset,q) }
module reg3e(d[3],en,clk,reset -> q[3]) {
  mux2(en, q[0], d[0], _n0)
  dffr(_n0, clk, reset, q[0])
  mux2(en, q[1], d[1], _n1)
  dffr(_n1, clk, reset, q[1])
  mux2(en, q[2], d[2], _n2)
  dffr(_n2, clk, reset, q[2])
}
module reg4e(d[4],en,clk,reset -> q[4]) {
  mux2(en, q[0], d[0], _n0)
  dffr(_n0, clk, reset, q[0])
  mux2(en, q[1], d[1], _n1)
  dffr(_n1, clk, reset, q[1])
  mux2(en, q[2], d[2], _n2)
  dffr(_n2, clk, reset, q[2])
  mux2(en, q[3], d[3], _n3)
  dffr(_n3, clk, reset, q[3])
}
module reg8e(d[8],en,clk,reset -> q[8]) {
  mux2(en, q[0], d[0], _n0)
  dffr(_n0, clk, reset, q[0])
  mux2(en, q[1], d[1], _n1)
  dffr(_n1, clk, reset, q[1])
  mux2(en, q[2], d[2], _n2)
  dffr(_n2, clk, reset, q[2])
  mux2(en, q[3], d[3], _n3)
  dffr(_n3, clk, reset, q[3])
  mux2(en, q[4], d[4], _n4)
  dffr(_n4, clk, reset, q[4])
  mux2(en, q[5], d[5], _n5)
  dffr(_n5, clk, reset, q[5])
  mux2(en, q[6], d[6], _n6)
  dffr(_n6, clk, reset, q[6])
  mux2(en, q[7], d[7], _n7)
  dffr(_n7, clk, reset, q[7])
}
module reg12e(d[12],en,clk,reset -> q[12]) {
  mux2(en, q[0], d[0], _n0)
  dffr(_n0, clk, reset, q[0])
  mux2(en, q[1], d[1], _n1)
  dffr(_n1, clk, reset, q[1])
  mux2(en, q[2], d[2], _n2)
  dffr(_n2, clk, reset, q[2])
  mux2(en, q[3], d[3], _n3)
  dffr(_n3, clk, reset, q[3])
  mux2(en, q[4], d[4], _n4)
  dffr(_n4, clk, reset, q[4])
  mux2(en, q[5], d[5], _n5)
  dffr(_n5, clk, reset, q[5])
  mux2(en, q[6], d[6], _n6)
  dffr(_n6, clk, reset, q[6])
  mux2(en, q[7], d[7], _n7)
  dffr(_n7, clk, reset, q[7])
  mux2(en, q[8], d[8], _n8)
  dffr(_n8, clk, reset, q[8])
  mux2(en, q[9], d[9], _n9)
  dffr(_n9, clk, reset, q[9])
  mux2(en, q[10], d[10], _n10)
  dffr(_n10, clk, reset, q[10])
  mux2(en, q[11], d[11], _n11)
  dffr(_n11, clk, reset, q[11])
}
module decoder3to8(a0,a1,a2 -> d0,d1,d2,d3,d4,d5,d6,d7) {
  inv(a0,_n0) inv(a1,_n1) inv(a2,_n2)
  and3(_n0,_n1,_n2,d0)
  and3(a0,_n1,_n2,d1)
  and3(_n0,a1,_n2,d2)
  and3(a0,a1,_n2,d3)
  and3(_n0,_n1,a2,d4)
  and3(a0,_n1,a2,d5)
  and3(_n0,a1,a2,d6)
  and3(a0,a1,a2,d7)
}
module decoder4to16(a0,a1,a2,a3 -> d0,d1,d2,d3,d4,d5,d6,d7,d8,d9,d10,d11,d12,d13,d14,d15) {
  inv(a0,_n0) inv(a1,_n1) inv(a2,_n2) inv(a3,_n3)
  and4(_n0,_n1,_n2,_n3,d0)
  and4(a0,_n1,_n2,_n3,d1)
  and4(_n0,a1,_n2,_n3,d2)
  and4(a0,a1,_n2,_n3,d3)
  and4(_n0,_n1,a2,_n3,d4)
  and4(a0,_n1,a2,_n3,d5)
  and4(_n0,a1,a2,_n3,d6)
  and4(a0,a1,a2,_n3,d7)
  and4(_n0,_n1,_n2,a3,d8)
  and4(a0,_n1,_n2,a3,d9)
  and4(_n0,a1,_n2,a3,d10)
  and4(a0,a1,_n2,a3,d11)
  and4(_n0,_n1,a2,a3,d12)
  and4(a0,_n1,a2,a3,d13)
  and4(_n0,a1,a2,a3,d14)
  and4(a0,a1,a2,a3,d15)
}
module add4(a[4],b[4],cin -> y[4],cout) { fulladder(a[0],b[0],cin,y[0],_c1) fulladder(a[1],b[1],_c1,y[1],_c2) fulladder(a[2],b[2],_c2,y[2],_c3) fulladder(a[3],b[3],_c3,y[3],cout) }
module inc4(a[4] -> y[4],cout) { inv(a[0],y[0]) and2(a[0],Vcc,_c1) xor2(a[1],_c1,y[1]) and2(a[1],_c1,_c2) xor2(a[2],_c2,y[2]) and2(a[2],_c2,_c3) xor2(a[3],_c3,y[3]) and2(a[3],_c3,cout) }
module inc12(a[12] -> y[12]) {
  inv(a[0],y[0]) buf(a[0],_c1)
  xor2(a[1], _c1, y[1])
  and2(a[1], _c1, _c2)
  xor2(a[2], _c2, y[2])
  and2(a[2], _c2, _c3)
  xor2(a[3], _c3, y[3])
  and2(a[3], _c3, _c4)
  xor2(a[4], _c4, y[4])
  and2(a[4], _c4, _c5)
  xor2(a[5], _c5, y[5])
  and2(a[5], _c5, _c6)
  xor2(a[6], _c6, y[6])
  and2(a[6], _c6, _c7)
  xor2(a[7], _c7, y[7])
  and2(a[7], _c7, _c8)
  xor2(a[8], _c8, y[8])
  and2(a[8], _c8, _c9)
  xor2(a[9], _c9, y[9])
  and2(a[9], _c9, _c10)
  xor2(a[10], _c10, y[10])
  and2(a[10], _c10, _c11)
  xor2(a[11], _c11, y[11])
}
module zero4(a[4] -> z) { or4(a[0],a[1],a[2],a[3],_o) inv(_o,z) }
module not4(a[4] -> y[4]) { inv(a[0],y[0]) inv(a[1],y[1]) inv(a[2],y[2]) inv(a[3],y[3]) }
module sub4(a[4],b[4],borrow -> y[4],cout) { not4(b,_nb) inv(borrow,_nborr) add4(a,_nb,_nborr,y,cout) }
module daa4(a[4],carry -> y[4],cout) { or2(a[1],a[2],_o12) and2(a[3],_o12,_gt9) or2(carry,_gt9,_adj) pack4(Gnd,Vcc,Vcc,Gnd,_six) add4(a,_six,Gnd,_plus6,_c) mux4(_adj,a,_plus6,y) and2(_adj,_c,cout) }
module kbp4(a[4] -> y[4]) {
  decoder4to16(a[0],a[1],a[2],a[3],_d0,_d1,_d2,_d3,_d4,_d5,_d6,_d7,_d8,_d9,_d10,_d11,_d12,_d13,_d14,_d15)
  or4(_d0,_d1,_d2,_d4,_v0) or2(_v0,_d8,_valid) inv(_valid,_bad)
  or3(_d1,_d4,_bad,y[0]) or3(_d2,_d4,_bad,y[1]) or2(_d8,_bad,y[2]) buf(_bad,y[3])
}
module mux16x4(sel[4], r0[4],r1[4],r2[4],r3[4],r4[4],r5[4],r6[4],r7[4],r8[4],r9[4],r10[4],r11[4],r12[4],r13[4],r14[4],r15[4] -> y[4]) {
  mux4(sel[0], r0, r1, _m0)
  mux4(sel[0], r2, r3, _m1)
  mux4(sel[0], r4, r5, _m2)
  mux4(sel[0], r6, r7, _m3)
  mux4(sel[0], r8, r9, _m4)
  mux4(sel[0], r10, r11, _m5)
  mux4(sel[0], r12, r13, _m6)
  mux4(sel[0], r14, r15, _m7)
  mux4(sel[1], _m0, _m1, _n0)
  mux4(sel[1], _m2, _m3, _n1)
  mux4(sel[1], _m4, _m5, _n2)
  mux4(sel[1], _m6, _m7, _n3)
  mux4(sel[2], _n0, _n1, _p0)
  mux4(sel[2], _n2, _n3, _p1)
  mux4(sel[3], _p0, _p1, y)
}
module mux8x8(sel[3], r0[8],r1[8],r2[8],r3[8],r4[8],r5[8],r6[8],r7[8] -> y[8]) {
  mux8(sel[0], r0, r1, _m0)
  mux8(sel[0], r2, r3, _m1)
  mux8(sel[0], r4, r5, _m2)
  mux8(sel[0], r6, r7, _m3)
  mux8(sel[1], _m0, _m1, _n0)
  mux8(sel[1], _m2, _m3, _n1)
  mux8(sel[2], _n0, _n1, y)
}
module regfile16(clk,reset,sel[4],pairsel[3],we_single,single_data[4],we_pair,pair_data[8] -> selected[4],pair_selected[8],r01[8]) {
  decoder4to16(sel[0],sel[1],sel[2],sel[3],_s0,_s1,_s2,_s3,_s4,_s5,_s6,_s7,_s8,_s9,_s10,_s11,_s12,_s13,_s14,_s15)
  decoder3to8(pairsel[0],pairsel[1],pairsel[2],_p0,_p1,_p2,_p3,_p4,_p5,_p6,_p7)
  pack4(pair_data[0],pair_data[1],pair_data[2],pair_data[3], _pd0)
  and2(we_single,_s0,_ws0)
  and2(we_pair,_p0,_wp0)
  or2(_ws0,_wp0,_we0)
  mux4(_wp0,single_data,_pd0,_din0)
  reg4e(_din0,_we0,clk,reset,_r0)
  pack4(pair_data[4],pair_data[5],pair_data[6],pair_data[7], _pd1)
  and2(we_single,_s1,_ws1)
  and2(we_pair,_p0,_wp1)
  or2(_ws1,_wp1,_we1)
  mux4(_wp1,single_data,_pd1,_din1)
  reg4e(_din1,_we1,clk,reset,_r1)
  pack4(pair_data[0],pair_data[1],pair_data[2],pair_data[3], _pd2)
  and2(we_single,_s2,_ws2)
  and2(we_pair,_p1,_wp2)
  or2(_ws2,_wp2,_we2)
  mux4(_wp2,single_data,_pd2,_din2)
  reg4e(_din2,_we2,clk,reset,_r2)
  pack4(pair_data[4],pair_data[5],pair_data[6],pair_data[7], _pd3)
  and2(we_single,_s3,_ws3)
  and2(we_pair,_p1,_wp3)
  or2(_ws3,_wp3,_we3)
  mux4(_wp3,single_data,_pd3,_din3)
  reg4e(_din3,_we3,clk,reset,_r3)
  pack4(pair_data[0],pair_data[1],pair_data[2],pair_data[3], _pd4)
  and2(we_single,_s4,_ws4)
  and2(we_pair,_p2,_wp4)
  or2(_ws4,_wp4,_we4)
  mux4(_wp4,single_data,_pd4,_din4)
  reg4e(_din4,_we4,clk,reset,_r4)
  pack4(pair_data[4],pair_data[5],pair_data[6],pair_data[7], _pd5)
  and2(we_single,_s5,_ws5)
  and2(we_pair,_p2,_wp5)
  or2(_ws5,_wp5,_we5)
  mux4(_wp5,single_data,_pd5,_din5)
  reg4e(_din5,_we5,clk,reset,_r5)
  pack4(pair_data[0],pair_data[1],pair_data[2],pair_data[3], _pd6)
  and2(we_single,_s6,_ws6)
  and2(we_pair,_p3,_wp6)
  or2(_ws6,_wp6,_we6)
  mux4(_wp6,single_data,_pd6,_din6)
  reg4e(_din6,_we6,clk,reset,_r6)
  pack4(pair_data[4],pair_data[5],pair_data[6],pair_data[7], _pd7)
  and2(we_single,_s7,_ws7)
  and2(we_pair,_p3,_wp7)
  or2(_ws7,_wp7,_we7)
  mux4(_wp7,single_data,_pd7,_din7)
  reg4e(_din7,_we7,clk,reset,_r7)
  pack4(pair_data[0],pair_data[1],pair_data[2],pair_data[3], _pd8)
  and2(we_single,_s8,_ws8)
  and2(we_pair,_p4,_wp8)
  or2(_ws8,_wp8,_we8)
  mux4(_wp8,single_data,_pd8,_din8)
  reg4e(_din8,_we8,clk,reset,_r8)
  pack4(pair_data[4],pair_data[5],pair_data[6],pair_data[7], _pd9)
  and2(we_single,_s9,_ws9)
  and2(we_pair,_p4,_wp9)
  or2(_ws9,_wp9,_we9)
  mux4(_wp9,single_data,_pd9,_din9)
  reg4e(_din9,_we9,clk,reset,_r9)
  pack4(pair_data[0],pair_data[1],pair_data[2],pair_data[3], _pd10)
  and2(we_single,_s10,_ws10)
  and2(we_pair,_p5,_wp10)
  or2(_ws10,_wp10,_we10)
  mux4(_wp10,single_data,_pd10,_din10)
  reg4e(_din10,_we10,clk,reset,_r10)
  pack4(pair_data[4],pair_data[5],pair_data[6],pair_data[7], _pd11)
  and2(we_single,_s11,_ws11)
  and2(we_pair,_p5,_wp11)
  or2(_ws11,_wp11,_we11)
  mux4(_wp11,single_data,_pd11,_din11)
  reg4e(_din11,_we11,clk,reset,_r11)
  pack4(pair_data[0],pair_data[1],pair_data[2],pair_data[3], _pd12)
  and2(we_single,_s12,_ws12)
  and2(we_pair,_p6,_wp12)
  or2(_ws12,_wp12,_we12)
  mux4(_wp12,single_data,_pd12,_din12)
  reg4e(_din12,_we12,clk,reset,_r12)
  pack4(pair_data[4],pair_data[5],pair_data[6],pair_data[7], _pd13)
  and2(we_single,_s13,_ws13)
  and2(we_pair,_p6,_wp13)
  or2(_ws13,_wp13,_we13)
  mux4(_wp13,single_data,_pd13,_din13)
  reg4e(_din13,_we13,clk,reset,_r13)
  pack4(pair_data[0],pair_data[1],pair_data[2],pair_data[3], _pd14)
  and2(we_single,_s14,_ws14)
  and2(we_pair,_p7,_wp14)
  or2(_ws14,_wp14,_we14)
  mux4(_wp14,single_data,_pd14,_din14)
  reg4e(_din14,_we14,clk,reset,_r14)
  pack4(pair_data[4],pair_data[5],pair_data[6],pair_data[7], _pd15)
  and2(we_single,_s15,_ws15)
  and2(we_pair,_p7,_wp15)
  or2(_ws15,_wp15,_we15)
  mux4(_wp15,single_data,_pd15,_din15)
  reg4e(_din15,_we15,clk,reset,_r15)
